{
  "name": "opengym",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "start": "node dist/server.cjs",
    "build": "vite build && esbuild server.js --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && node scripts/copy-media.js",
    "lint": "vite build --mode development",
    "migrate:firebase": "node scripts/migrate-to-firebase.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@capacitor/core": "^7.6.8",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/share": "^7.0.4",
    "@simplewebauthn/server": "^13.1.1",
    "firebase-admin": "^14.3.0",
    "mongodb": "^7.5.0",
    "mysql2": "^3.23.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2",
    "web-push": "^3.6.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.8",
    "@capacitor/ios": "^7.6.8",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "^0.28.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
